# ── Okta Org ─────────────────────────────────────────────────────────────────
OKTA_DOMAIN=https://your-org.oktapreview.com/
# SSWS admin token — used by both the runtime agents' Connections API calls
# (p3-agent/p6-agent) and the demo's setup/lifecycle/teardown scripts
OKTA_API_TOKEN=

# ── Console / App URLs ────────────────────────────────────────────────────────
# Comma-separated console base URLs — a redirect URI set is created in Okta for each
NEXTAUTH_URL=http://localhost:3020
CONSOLE_PORT=3020

# ── MCP Bridge (P1/P2) ────────────────────────────────────────────────────────
MCP_ADAPTER_URL=

# ── Shared demo directory ─────────────────────────────────────────────────────
DEMO_SALES_GROUP_ID=

# ── MCP Resource Servers (shared across P1, P2, P3, P6) ──────────────────────
HR_AUTHZ_SERVER_ID=
HR_RESOURCE_AUDIENCE=api:hr
FINANCE_AUTHZ_SERVER_ID=
FINANCE_RESOURCE_AUDIENCE=api:finance
INVENTORY_AUTHZ_SERVER_ID=
INVENTORY_RESOURCE_AUDIENCE=api://inventory-resource

# ── Pattern 1: 3rd Party Coding Assistant ────────────────────────────────────
P1_OKTA_AI_AGENT_ID=

# ── Pattern 2: 3rd Party Consumer Agent ──────────────────────────────────────
P2_OKTA_AI_AGENT_ID=

# ── Pattern 3: 1st Party XAA Native ─────────────────────────────────────────
P3_OKTA_CLIENT_ID=
P3_OKTA_CLIENT_SECRET=
P3_OKTA_AI_AGENT_ID=
# JWK private key (JSON), used for private_key_jwt client auth
P3_OKTA_PRIVATE_KEY=

# ── Pattern 6: Agent-to-Agent (A2A) delegation ───────────────────────────────
# Orchestrator
P6_ORCHESTRATOR_OKTA_CLIENT_ID=
P6_ORCHESTRATOR_OKTA_CLIENT_SECRET=
P6_ORCHESTRATOR_OKTA_AI_AGENT_ID=
P6_ORCHESTRATOR_OKTA_PRIVATE_KEY=
# Orchestrator-as-a-resource (Mission 1 / CC inbound validation)
P6_ORCH_A2A_RESOURCE=https://orchestrator-agent
P6_ORCH_A2A_AUTHZ_SERVER_ID=
# HR Worker
P6_HR_WORKER_OKTA_AI_AGENT_ID=
P6_HR_WORKER_PRIVATE_KEY=
# Finance Worker
P6_FINANCE_WORKER_OKTA_AI_AGENT_ID=
P6_FINANCE_WORKER_PRIVATE_KEY=

# NOTE: this tenant is still missing the manual A2A objects (worker→A2A-server
# publish, IDENTITY_ASSERTION_A2A_SERVER connections, delegation links) — see
# docs/setup.md → "P6 — manual A2A resources" before P6 will actually run.

# ── Pattern 7: Agentic Permission Scoping (Okta FGA) ─────────────────────────
# Reuses P3_OKTA_AI_AGENT_ID / P3_OKTA_PRIVATE_KEY — no new agent identity.
OKTA_FGA_API_URL=https://api.us1.fga.dev/
OKTA_FGA_STORE_ID=
OKTA_FGA_CLIENT_ID=
OKTA_FGA_CLIENT_SECRET=
OKTA_FGA_AUTHORIZATION_MODEL_ID=
